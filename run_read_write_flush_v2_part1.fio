[global]
ioengine=libaio
direct=1
bs=4k
# Replace with your target NVMe or SATA device path
filename=/dev/nvme0n1
# Stop immediately when an abort or timeout error occurs to preserve FW state
exitall_on_error=1
continue_on_error=none
group_reporting=1

# -------------------------------------------------------------------------
# Phase 0: Trim (Deallocate) the entire drive (0% - 100%) before starting
# Use a large block size (1G) so the full-drive discard finishes in seconds.
# -------------------------------------------------------------------------
[phase0_trim_all]
offset=0%
size=100%
bs=1g
rw=trim
iodepth=1
numjobs=1

# -------------------------------------------------------------------------
# Phase 1: Fill Zone A (0% - 64%) sequentially with 1MB blocks to exhaust SLC cache
# CRITICAL: Must include 'stonewall' so it waits for Phase 0 Trim to finish!
# Exhausts dynamic SLC cache and maps the 64% LBA range in Zone A so subsequent
# Phase 3B random writes overwrite valid mapped LBAs without free SLC buffer.
# -------------------------------------------------------------------------
[phase1_fill_zone_A]
stonewall
offset=0%
size=64%
bs=1024k
rw=write
iodepth=64
numjobs=1

# -------------------------------------------------------------------------
# Phase 2: Fill Zone B (64% - 65%) sequentially after SLC cache is full
# Ensures physical superblocks holding Zone B data at offset 64% are sealed
# in TLC blocks with 100% Valid Count for Phase 3A Read Disturb hammering.
# -------------------------------------------------------------------------
[phase2_fill_zone_B]
stonewall
offset=64%
size=1%
bs=1024k
rw=write
iodepth=64
numjobs=1
