[global]
ioengine=libaio
direct=1
time_based=1
runtime=3600
iodepth=16
group_reporting=1
randrepeat=0
norandommap=1
nrfiles=4
filesize=10m-100m
directory=/usr/local/illumina/SSDtest

[seqwrite]
rw=write
bs=1m

[seqread]
rw=read
bs=1m

[randwrite]
rw=randwrite
bssplit=4k/5:8k/10:16k/40:32k/20:64k/10:128k/5

[randread]
rw=randread
bssplit=4k/5:8k/10:16k/40:32k/20:64k/10:128k/5
