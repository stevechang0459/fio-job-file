[global]
ioengine=libaio
direct=1
bs=4k
# Replace with your target NVMe or SATA device path
filename=/dev/nvme0n1
# Stop immediately when an abort or timeout error occurs to preserve FW state
exitall_on_error=1
continue_on_error=none
group_reporting=1

# -------------------------------------------------------------------------
# Phase 0: Trim (Deallocate) the entire drive (0% - 100%) before starting
# Use a large block size (1G) so the full-drive discard finishes in seconds.
# -------------------------------------------------------------------------
[phase0_trim_all]
offset=0%
size=100%
bs=1g
rw=trim
iodepth=1
numjobs=1

# -------------------------------------------------------------------------
# Phase 1: Fill Zone A (0% - 1%) sequentially with 1MB blocks
# CRITICAL: Must include 'stonewall' so it waits for Phase 0 Trim to finish!
# Result: Physical superblocks holding Zone A data are sealed with 100% Valid Count.
# -------------------------------------------------------------------------
[phase1_fill_zone_A]
stonewall
offset=0%
size=1%
bs=1024k
rw=write
iodepth=32
numjobs=1

# -------------------------------------------------------------------------
# Phase 2: Pre-fill Zone B (1% - 85%) with 1MB sequential writes (1 pass)
# Quickly maps the 84% LBA range in Zone B at peak speed so subsequent
# Phase 3B random writes are guaranteed to overwrite valid mapped LBAs.
# -------------------------------------------------------------------------
[phase2_prefill_zone_B]
stonewall
offset=1%
size=84%
bs=1024k
rw=write
iodepth=64
numjobs=1

# -------------------------------------------------------------------------
# Phase 3A: Hammer a narrow 16MB slice in Zone A (offset 0%) with 256K reads
# 'stonewall' waits for Phase 2 to finish and starts a new reporting group.
# 4 jobs x iodepth 1024 saturate all NAND channels on a small closed-block
# range to rapidly trigger Read Disturb and slow down background merges.
# -------------------------------------------------------------------------
[phase3_read_zone_A]
stonewall
offset=0%
size=16m
rw=randread
bs=256k
norandommap=1
iodepth=1024
numjobs=4
time_based=1
runtime=36000

# -------------------------------------------------------------------------
# Phase 3B-1: Pure async Write job (NO fsync so libaio NEVER blocks!)
# NO 'stonewall' here so it runs in parallel with [phase3_read_zone_A].
# Continuously pumps 4K-16K writes into Zone B (1% - 85%) at 32 IOPS x 4 jobs
# (128 Write IOPS total), filling iodepth=64 even when the SSD stalls.
# -------------------------------------------------------------------------
[phase3_write_zone_B]
offset=1%
size=84%
rw=randwrite
bsrange=4k-16k
norandommap=1
iodepth=64
numjobs=4
randrepeat=0
time_based=1
runtime=36000
rate_iops=32

# -------------------------------------------------------------------------
# Phase 3B-2: Dedicated Flush job running in parallel (NO 'stonewall')
# Issues 4K writes + immediate Flush (fsync=1) at 4 IOPS (4 Flushes/sec)
# to continuously trigger TBL_FLUSH / TBL_MERGE without blocking
# [phase3_write_zone_B] from queuing new async writes.
# -------------------------------------------------------------------------
[phase3_flush_zone_B]
offset=1%
size=84%
rw=randwrite
bs=4k
norandommap=1
iodepth=1
numjobs=1
randrepeat=0
time_based=1
runtime=36000
rate_iops=4
fsync=1
