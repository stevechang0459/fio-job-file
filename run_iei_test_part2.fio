[global]
ioengine=libaio
direct=1
iodepth=16
group_reporting=1
randrepeat=0
norandommap=1
# Point to the mounted data drive directory on your test PC
directory=/mnt/illumina/SSDtest
exitall_on_error=1
continue_on_error=none

# =========================================================================
# Phase 3: Exact IEI 4-Job Workload + OS Background Journal Flush Simulation
# Unified runtime=36000 (10 hours) across all 4 concurrent jobs.
# =========================================================================

[seqwrite]
stonewall
rw=write
bs=1m
nrfiles=4
filesize=10m-100m
time_based=1
runtime=36000

[seqread]
rw=read
bs=1m
filename_format=seqread.0.$filenum
nrfiles=4
filesize=10m-100m
time_based=1
runtime=36000

[randwrite]
rw=randwrite
bssplit=4k/5:8k/10:16k/40:32k/20:64k/10:128k/5
nrfiles=4
filesize=10m-100m
time_based=1
runtime=36000
# Simulate background OS (systemd-journald / syslog) periodic fsync on an OS drive
fsync=64

[randread]
rw=randread
bssplit=4k/5:8k/10:16k/40:32k/20:64k/10:128k/5
filename_format=randread.0.$filenum
nrfiles=4
filesize=10m-100m
time_based=1
runtime=36000
